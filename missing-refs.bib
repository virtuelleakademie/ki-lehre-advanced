@article{koedingerLearningCurveAnalysis2015,
  title = {Learning Is Not a Spectator Sport: Doing Is Better than Watching for Learning from a {{MOOC}}},
  shorttitle = {Learning Is Not a Spectator Sport},
  author = {Koedinger, Kenneth R. and Kim, Jihee and Jia, Julianna Z. and McLaughlin, Elizabeth A. and Bier, Norman L.},
